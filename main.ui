     <property name="styleSheet">
      <string notr="true">/* ✅ QDoubleSpinBox 整體樣式 */
QDoubleSpinBox {
    color: white;
    background-color: transparent;
    font-size: 20px;
    border: 1px solid white;
    border-radius: 4px;
    padding: 2px 6px;
}
/* ✅ 讓內部文字區域透明（關鍵） */
QAbstractSpinBox::viewport {
    background: transparent;
}

QAbstractSpinBox::up-button, QAbstractSpinBox::down-button {
    width: 0;
    height: 0;
    border: none;
}</string>
