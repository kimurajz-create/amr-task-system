     <property name="styleSheet">
      <string notr="true">QTableWidget::item {
    padding: 5px;
    /*background-color: #1a1a1a;   深灰色背景 */
   /*color: white;                文字顏色 */
    gridline-color: #333333;    /* 格線顏色 */
    white-space: pre-wrap;
    border-bottom:1.5px solid   #2b2b2b;
}
QHeaderView::section {
    background-color: #2b2b2b;  /* 表頭背景色 */
    color: white;               /* 表頭文字顏色，這行 CSS 告訴 Qt：表格中的所有文字，除非被更具體的規則覆蓋，否則都必須是白色。 */
    padding: 5px;               /* 內邊距 */
    border-bottom: 2px solid #2b2b2b; /* 表頭底線 */
    font: 14pt;
}

</string>
