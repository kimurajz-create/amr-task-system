     <property name="styleSheet">
      <string notr="true">/* ✅ CheckBox 文字樣式 */
QCheckBox {
    background-color: rgb(72, 72, 72);
    color: white;                  /* 白字 */
    border-radius: 10px;           /* 圓角 */
    padding: 6px 12px;             /* 內距 */
    font-size:14px;               /* 字體大小 */
    spacing: 10px; /* ✅ 推薦加上 spacing，讓框與文字不會太擠 */
}

/* ✅ CheckBox 框框大小 + 未勾選時顏色 */
QCheckBox::indicator {
    width: 20px;
    height: 20px;
    background-color:transparent;   /* 沒勾選時的框色 */
    border: 1px solid white;     /* 加邊框讓它更清楚 */
    border-radius: 4px;          /* 圓角（選配） */
}

/* ✅ CheckBox 勾選時顏色 */
QCheckBox::indicator:checked {
    background-color:white; 
    image: url(:/icons/icons/check.svg);
}

</string>
