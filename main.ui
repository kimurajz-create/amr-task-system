QHeaderView::section {
    background-color: #2b2b2b;  /* 銵券???*/
    color: white;               /* 銵券??憿嚗? CSS ?迄 Qt嚗”?潔葉????摮??日?鋡急?琿????????血??賢???質??*/
    padding: 5px;               /* ?折?頝?*/
    border-bottom: 2px solid #2b2b2b; /* 銵券摨? */
    font: 14pt;
}

</string>
