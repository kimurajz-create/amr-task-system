     <property name="styleSheet">
      <string notr="true">/* ??CheckBox ??璅?? */
QCheckBox {
    background-color: rgb(72, 72, 72);
    color: white;                  /* ?賢? */
    border-radius: 10px;           /* ?? */
    padding: 6px 12px;             /* ?扯? */
    font-size:14px;               /* 摮?憭批? */
    spacing: 10px; /* ???刻?? spacing嚗?獢???銝?憭芣? */
}

/* ??CheckBox 獢?憭批? + ?芸?豢?憿 */
QCheckBox::indicator {
    width: 20px;
    height: 20px;
    background-color:transparent;   /* 瘝?豢?????*/
    border: 1px solid white;     /* ??獢?摰皜? */
    border-radius: 4px;          /* ??嚗?? */
}

/* ??CheckBox ?暸????*/
QCheckBox::indicator:checked {
    background-color:white; 
    image: url(:/icons/icons/check.svg);
}

</string>
