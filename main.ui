       <weight>50</weight>
       <bold>false</bold>
      </font>
     </property>
     <property name="toolTip">
      <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;流水號:&lt;br/&gt;任務排序:&lt;br/&gt;任務內容:從手術室07-A前 往滅菌室-5, 完成後續執行任務&lt;br/&gt;新增人:蔡明勳(1002)&lt;/p&gt;&lt;p&gt;&lt;br/&gt;&lt;/p&gt;&lt;p&gt;&lt;br/&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
     </property>
     <property name="styleSheet">
      <string notr="true">QLabel#label_rp_1 {
    /* 1. 大小和邊距 (將 QLabel 視為 'Frame 15') 這些的樣式似乎被程式限制了*/
    /* 注意：Qt Widgets 的大小通常由內容或 Layout 決定，這裡設定一個基線 */
    min-width: 12px;
    max-width: 12px;
    min-height: 20px;
    max-height: 20px;

    /* 2. 邊框 (Borders) */
    /* 圓角 (Radius: 2px) */
    border-radius: 2px;
    /* 邊框線 (Border: 1px) + 顏色 (#525252) */
    border: 1px solid #525252;
    
    /* 3. 顏色 (Colors) - 作為背景色 */
    /* 這裡將 #33B1FF 設定為預設背景色 */
    background-color: #33B1FF;

    /* 4. 內邊距 (Padding: 2px) */
    /* 這會影響 Label 內容（文字或圖片）與邊框的距離 */
    padding: 2px; 
    
    /* 5. 文字對齊 (Inner alignment) */
    /* 假設 'Inner alignment' 是指內容置中 */
    text-align: center; 
    
    /* Flow 和 Gap 屬性（如 Vertical, 10px）屬於 Layout 管理器的職責，QSS 無法直接控制 */
}

/* 設定所有 QToolTip 的樣式 */
QToolTip {
    background-color: black;  /* 背景顏色設為黑色 */
    color: white;             /* 文字顏色設為白色 */
    border: 1px solid darkgray; /* 邊框 */
    border-radius: 4px;       /* 圓角 */
    padding: 4px;             /* 內邊距 */
}</string>
     </property>
